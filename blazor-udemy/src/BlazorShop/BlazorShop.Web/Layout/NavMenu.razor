@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorShop.Web</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @* <div class="nav-item px-3"> *@
        @*     <NavLink class="nav-link" href="produtos"> *@
        @*         <span class="bi bi-shop-window" aria-hidden="true"></span> Produtos *@
        @*     </NavLink> *@
        @* </div> *@
        <ProdutosCategoriaNavMenu />
        <div class="nav-item px-3 d-sm-none">
            <NavLink class="nav-link" href="carrinho">
                <span class="bi bi-cart" aria-hidden="true"></span>&nbsp;Carrinho (<b>@carrinhoCompraItemContador</b>)
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private int carrinhoCompraItemContador;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    
    protected override void OnInitialized()
    {
        CarrinhoCompraService.OnCarrinhoCompraChanged += CarrinhoCompraChanged;
    }
    
    private void CarrinhoCompraChanged(int totalQuantidade)
    {
        carrinhoCompraItemContador = totalQuantidade;
        StateHasChanged();
    }

    public void Dispose()
    {
        CarrinhoCompraService.OnCarrinhoCompraChanged -= CarrinhoCompraChanged;
    }
}