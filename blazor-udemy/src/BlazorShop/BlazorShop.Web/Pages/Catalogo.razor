@page "/produtos"

@if (Produtos is null)
{
    <h3>A carregar produtos ...</h3>
    <ExibirSpinner />
}
else
{
    <h3 class="mb-5">Produtos</h3>    

    @if (Produtos.Any())
    {
        var produtosPorCategoria =
            from produto in Produtos
            group produto by produto.CategoriaId
            into prodPorCatGrupo
            orderby prodPorCatGrupo.Key
            select prodPorCatGrupo;

        @foreach (var prodGrupo in produtosPorCategoria)
        {
            <h4>@prodGrupo.FirstOrDefault(pg => pg.CategoriaId == prodGrupo.Key)!.CategoriaNome</h4>
            <div class="row mt-3">
                <ExibirProdutos Produtos="@prodGrupo" />
            </div>
            <hr class="mb-2"/>
        }
    }
} 

@code 
{
    public IEnumerable<ProdutoDto>? Produtos { get; set; }

    public string MensagemErro { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LimpaLocalStorage();

            Produtos = await ProdutosLocalStorageService.GetProdutosLocalStorageAsync();

            var carrinhoCompraItens = 
                await CarrinhoItensLocalStorageService.GetCarrinhoItemsLocalStorageAsync();
            
            var totalQuantidade = carrinhoCompraItens.Sum(i => i.Quantidade);

            CarrinhoCompraService.RaiseEventOnCarrinhoCompraChanged(totalQuantidade);
        }
        catch (Exception e)
        {
            MensagemErro = e.Message;
        }
    }

    private async Task LimpaLocalStorage()
    {
        await ProdutosLocalStorageService.RemoveProdutosLocalStorageAsync();
        await CarrinhoItensLocalStorageService.RemoveCarrinhoItensLocalStorageAsync();
    }
}