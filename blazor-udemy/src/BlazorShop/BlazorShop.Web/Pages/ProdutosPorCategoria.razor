@page "/produtosporcategoria/{categoriaId:int}"

@if (ProdutosDto is null && MensagemErro is null)
{
    <ExibirSpinner />
}
else if (MensagemErro is not null)
{
    <ExibirErro MensagemErro="@MensagemErro"></ExibirErro> 
}
else
{
    <h3>Produtos (@NomeCategoria)</h3>
    
    @if (ProdutosDto.Count() > 0)
    {
        <div class="row mt-3">
            <ExibirProdutos Produtos="@ProdutosDto"></ExibirProdutos>
        </div>
    }
}

<h3>ProdutosPorCategoria</h3>

@code {
    [Parameter]
    public int CategoriaId { get; set; }
    
    public IEnumerable<ProdutoDto> ProdutosDto { get; set; }
    public string? NomeCategoria { get; set; }
    public string? MensagemErro { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            ProdutosDto = await GetColeccaoProdutosPorCategoriaIdAsync(CategoriaId);
            if (ProdutosDto is not null && ProdutosDto.Count() > 0)
            {
                var produtosDto = ProdutosDto.FirstOrDefault(p => p.CategoriaId == CategoriaId);
                if (produtosDto is not null)
                {
                    NomeCategoria = produtosDto.CategoriaNome;
                }
            }
        }
        catch (Exception e)
        {
            MensagemErro = e.Message;
        }
    }

    private async Task<IEnumerable<ProdutoDto>> GetColeccaoProdutosPorCategoriaIdAsync(int categoriaId)
    {
        var produtosCollection = await ProdutosLocalStorageService.GetProdutosLocalStorageAsync();

        if (produtosCollection is not null)
        {
            return produtosCollection.Where(p => p.CategoriaId == categoriaId);
        }

        return await ProdutoService.GetItensPorCategoriaAsync(categoriaId);
    }
}