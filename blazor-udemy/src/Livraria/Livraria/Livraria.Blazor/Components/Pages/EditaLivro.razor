@page "/editalivro/{id:int}"

<PageTitle>Edita Livro</PageTitle>

<div class="row justify-content-center">
    <div class="col-6">
        <LivroForm ModoEdicao="true" Id="@Id" OnValidaLivroSubmit="EditarLivro" />
    </div>
</div>

@code 
{
    [Parameter]
    public int Id { get; set; }

    private async Task EditarLivro(Livro livro)
    {
        await LivroRepository.AtualizarLivroAsync(livro);
        Navigation.NavigateTo("/livro");
    }
}