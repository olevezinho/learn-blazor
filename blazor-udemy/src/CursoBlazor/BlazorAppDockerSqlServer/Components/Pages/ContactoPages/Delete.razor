@page "/contactos/delete"
@using Microsoft.EntityFrameworkCore
@using BlazorAppDockerSqlServer.Data
@inject IDbContextFactory<BlazorAppDockerSqlServer.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Contacto</h2>
    <hr />
    @if (contacto is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@contacto.Nome</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@contacto.Email</dd>
        </dl>
        <EditForm method="post" Model="contacto" OnValidSubmit="DeleteContacto" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(contacto is null)">Delete</button> |
            <a href="/contactos">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Contacto? contacto;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        contacto = await context.Contactos.FirstOrDefaultAsync(m => m.Id == Id);

        if (contacto is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteContacto()
    {
        using var context = DbFactory.CreateDbContext();
        context.Contactos.Remove(contacto!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactos");
    }
}
