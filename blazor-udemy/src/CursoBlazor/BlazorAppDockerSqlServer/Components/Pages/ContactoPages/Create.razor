@page "/contactos/create"
@using Microsoft.EntityFrameworkCore
@using BlazorAppDockerSqlServer.Data
@inject IDbContextFactory<BlazorAppDockerSqlServer.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Contacto</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Contacto" OnValidSubmit="AddContacto" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="nome" class="form-label">Nome:</label> 
                <InputText id="nome" @bind-Value="Contacto.Nome" class="form-control" /> 
                <ValidationMessage For="() => Contacto.Nome" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label> 
                <InputText id="email" @bind-Value="Contacto.Email" class="form-control" /> 
                <ValidationMessage For="() => Contacto.Email" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/contactos">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Contacto Contacto { get; set; } = default!;

    protected override void OnInitialized() => Contacto ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddContacto()
    {
        using var context = DbFactory.CreateDbContext();
        context.Contactos.Add(Contacto);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactos");
    }
}
