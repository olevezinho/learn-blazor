<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <Target Name="_RemovePublishDirBeforePublishing" BeforeTargets="BeforePublish">
        <RemoveDir Directories="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
    </Target>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
<!--        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>-->
<!--        <WasmBundlerFriendlyBootConfig>true</WasmBundlerFriendlyBootConfig>-->
<!--        <OutputType>Exe</OutputType>-->
<!--        <SelfContained>false</SelfContained>-->
<!--        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js"/>
    </ItemGroup>

</Project>
