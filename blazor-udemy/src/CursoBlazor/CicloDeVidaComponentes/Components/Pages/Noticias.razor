@page "/noticias"
@* @rendermode InteractiveServer *@

@* // Inibir a renderizacao interativa para este componente *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h3>Noticias</h3>

@if (isLoading)
{
    <p>A carregar notícias ...</p>
}
else
{
    <p>Notícias: (@noticias.Count)</p>
    <ul>
        @foreach(var noticia in noticias)
        {
            <li>@noticia.Titulo - @noticia.Data</li>
        }
    </ul>
}

@code {
    private bool isLoading = true;
    private List<Noticia> noticias = [];
    
    // definicao do record noticia
    public record Noticia(string Titulo, string Data);

    protected override async Task OnInitializedAsync()
    {
        // simula um atraso na carregamento de dados
        await Task.Delay(2000);
        
        // popula a lista de notícias
        noticias = new List<Noticia>
        {
            new Noticia("Notícia 1", DateTime.Now.ToString("dd/MM/yyyy")),
            new Noticia("Notícia 2", DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")),
            new Noticia("Notícia 3", DateTime.Now.AddDays(-2).ToString("dd/MM/yyyy"))
        };
        isLoading = false;
    }
}