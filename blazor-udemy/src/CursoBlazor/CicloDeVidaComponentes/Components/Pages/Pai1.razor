@page "/pai"
@rendermode InteractiveServer

<button @onclick='() => MudarParametros(1, "João")' class="btn btn-primary">Id 1, Nome: João</button>
<button @onclick='() => MudarParametros(2, "Maria")' class="btn btn-primary">Id 2, Nome: Maria</button>
<button @onclick='() => MudarParametros(0, " ")' class="btn btn-primary">Ids inválidos</button>

<Filho1 ItemId="@idAtual" Nome="@nomeAtual" />

@code {
    private int idAtual = 1;
    private string nomeAtual = "João";
    
    private void MudarParametros(int id, string nome)
    {
        idAtual = id;
        nomeAtual = nome;
    }
}