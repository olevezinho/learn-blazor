@page "/alunos"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialogProvider />
<MudSnackbarProvider />
<MudCard Elevation="25">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Color="Color.Primary">Adicionar e Editar alunos</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default"></MudIconButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField @bind-Value="aluno.Nome" Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
        <MudTextField @bind-Value="aluno.Email" Label="Email" Variant="Variant.Text" Margin="Margin.Normal"></MudTextField>
        <MudNumericField @bind-Value="aluno.Idade" Label="Idade" Variant="Variant.Filled" Margin="Margin.Normal"></MudNumericField>
        <br/>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GuardarAsync">Guardar Aluno</MudButton>
    </MudCardContent>
</MudCard>

<br />

<MudTable Elevation="25" Striped="true" Items="alunos" Filter="new Func<Aluno, bool>(Procurar)">
    <ToolBarContent>
        <MudText Typo="Typo.h5">Alunos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="criterio"
                      Placeholder="Procurar alunos ..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0">
        </MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Idade</MudTh>
        <MudTh>Operação</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">@context.Nome</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Idade">@context.Idade</MudTd>
        <MudTd DataLabel="">
            <MudFab @onclick="@(e => Editar(context.Id))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Editar</MudFab>
            <MudFab @onclick="@(e => ConfirmaRemocaoAsync(context.Id))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Delete">Remover</MudFab>
        </MudTd>
    </RowTemplate>
</MudTable>
@code {
    private string criterio = "";
    private Aluno aluno = new();
    private IEnumerable<Aluno> alunos = [];

    protected override async Task OnInitializedAsync()
    {
        await GetAlunos();
    }

    private async Task GetAlunos()
    {
        alunos = await AlunoService.ListarAlunosAsync();
    }

    private async Task GuardarAsync()
    {
        await AlunoService.GuardarAlunoAsync(aluno);
        aluno = new Aluno();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("Aluno guardado.", Severity.Success);
        await GetAlunos();
        StateHasChanged();
    }

    private bool Procurar(Aluno search)
    {
        if (string.IsNullOrWhiteSpace(criterio)) return true;

        if (search.Nome!.Contains(criterio, StringComparison.OrdinalIgnoreCase) ||
            search.Email!.Contains(criterio, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    private async Task ConfirmaRemocaoAsync(int id)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirma remoção",
            "A remoção não pode ser revertida!",
            yesText: "Remover",
            cancelText: "Cancelar");

        if (result ?? false)
        {
            await RemoveAsync(id);
        }
    }

    private async Task RemoveAsync(int id)
    {
        await AlunoService.RemoverAlunoAsync(id);
        Snackbar.Add("Aluno Removido", Severity.Info);
        await GetAlunos();
    }

    private void Editar(int id)
    {
        aluno = alunos.FirstOrDefault(a => a.Id == id);
    }

}