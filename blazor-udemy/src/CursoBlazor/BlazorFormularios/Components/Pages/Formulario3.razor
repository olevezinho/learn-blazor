@page "/formulario3-com-validacao"
@rendermode InteractiveServer

<h3>Registo de alunos com validação</h3>

<EditForm Model="@aluno"
          OnValidSubmit="EnviarFormularioValido">
    @* OnInvalidSubmit apenas para demonstração *@
    @* OnInvalidSubmit="TratarFormularioInvalido"> *@

    @* Componente de validação de dados: *@
    <DataAnnotationsValidator/>
    @* Componente que exibe todos os erros de validação: *@
    <ValidationSummary/>

    <div class="form-group">
        <label for="nome">Nome:</label>
        <InputText id="nome" @bind-Value="aluno.Nome" class="form-control"></InputText>
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Nome)"/>
    </div>

    <div class="form-group">
        <label for="email">E-mail:</label>
        <InputText id="email" @bind-Value="aluno.Email" class="form-control"></InputText>
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Email)"/>
    </div>

    <div class="form-group">
        <label for="idade">Idade:</label>
        <InputNumber id="idade" @bind-Value="aluno.Idade" class="form-control"></InputNumber>
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Idade)"/>
    </div>
    
    <div class="form-group">
        <label for="genero">Genero:</label>
        @* Genero com InputSelect: *@
        @* <InputSelect id="genero" @bind-Value="aluno.Genero" class="form-control"> *@
        @*     <option value="">Selecione...</option> *@
        @*     <option value="M">Masculino</option> *@
        @*     <option value="F">Feminino</option> *@
        @* </InputSelect> *@
        
        @* Genero com InputRadioGroup: *@
        <InputRadioGroup id="genero" @bind-Value="aluno.Genero" class="d-flex flex-column">
            <label class="form-check">
                <InputRadio class="form-check-label" Value="@("M")" />
                <span class="form-check-label">Masculino</span>
            </label>
            
            <label class="form-check">
                <InputRadio class="form-check-label" Value="@("F")" />
                <span class="form-check-label">Feminino</span>
            </label>
        </InputRadioGroup>
        
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Genero)"/>
    </div>
    
    <div class="form-group">
        <label for="matricula">Data da Matrícula:</label>
        <InputDate id="matricula" @bind-Value="aluno.Matricula" class="form-control"></InputDate>
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Matricula)"/>
    </div>
    
    <div class="form-group">
        <label for="mensalidade">Mensalidade:</label>
        <InputNumber id="mensalidade" @bind-Value="aluno.Mensalidade" class="form-control"></InputNumber>
        @* Componente que exibe apenas o erro de validação deste campo: *@
        <ValidationMessage For="@(() => aluno.Mensalidade)"/>
    </div>
    
    <div class="form-group">
        <label for="ativo">Ativo:</label>
        <InputCheckbox id="ativo" @bind-Value="aluno.Ativo" ></InputCheckbox>
    </div>

    <div class="mt-2">
        <input type="submit" value="Enviar" class="btn btn-primary"/>
        <button type="button" class="btn btn-secondary" @onclick="LimparFormulario">Limpar</button>
    </div>
</EditForm>

@code { 
    private Aluno aluno = new();

    private void EnviarFormularioValido(EditContext context)
    {
        Console.WriteLine($"Formulário válido! {aluno.Nome}, {aluno.Email}, {aluno.Idade} anos");
    }
    
    private void LimparFormulario()
    {
        aluno = new Aluno();
    }
    
    // Não é obrigatório implementar este método, apenas para demonstração
    // private void TratarFormularioInvalido(EditContext context)
    // {
    //     Console.WriteLine("Formulário contém erros de validação.");
    // }
}