@page "/uploadssr"

<div>
    <h3>Upload Static Server</h3>
    <p>Blazor Server-side Rendering</p>
</div>

@if (Mensagem.Length > 0)
{
    <p class="alert alert-secondary" role="alert">@Mensagem</p>
}

<EditForm Model="@Ficheiro" OnValidSubmit="@EnviarFicheiros" FormName="FormUpload" 
          method="post" enctype="multipart/form-data">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText class="form-control mb-4" placeholder="Titulo" @bind-Value="@Ficheiro.Titulo" />
    <InputText class="form-control mb-4" placeholder="Descricao" @bind-Value="@Ficheiro.Descricao" />
    <InputFile class="form-control mb-4" placeholder="Anexos" name="Ficheiro.Anexos" multiple />
    <button class="btn btn-primary" type="submit">Enviar Ficheiros</button>
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "FormUpload")]
    private FicheiroUpload Ficheiro { get; set; } = new();

    private string Mensagem { get; set; } = String.Empty;
    private long tamanhoMaximoFicheiro = 1 * 1024 * 1024; //1 MB;

    private async Task EnviarFicheiros()
    {
        var extensoesPermitidas = new[] { ".png", ".jpg", ".jpeg", ".gif" };
        Mensagem = "";

        if(Ficheiro.Anexos.Count <=0 )
        {
            Mensagem = "Nenhum ficheiro selecionado !!!";
            return;
        }

        try
        {
            foreach (var ficheiro in Ficheiro.Anexos)
            {
                string nomeFicheiro = WebUtility.HtmlEncode(ficheiro.FileName);
                var ficheiroExtensao = Path.GetExtension(nomeFicheiro);
                var nomeFicheiroSeguro = $"{Guid.NewGuid()}{ficheiroExtensao}";

                if (!extensoesPermitidas.Contains(ficheiroExtensao))
                {
                    Mensagem = $"Ficheiro: {nomeFicheiro}, é um tipo de Ficheiro não permitido";
                    return;
                }

                if (ficheiro.Length > tamanhoMaximoFicheiro)
                {
                    Mensagem = $"Ficheiro: {nomeFicheiro} excede o tamanho máximo permitido.";
                    return;
                }

                var diretorioUpload = Path.Combine(Env.WebRootPath, "uploads");

                if (!Directory.Exists(diretorioUpload))
                {
                    Directory.CreateDirectory(diretorioUpload);
                }

                // salva o arquivo localmente
                var path = Path.Combine(diretorioUpload, nomeFicheiroSeguro);
                await using FileStream fs = new(path, FileMode.Create);
                await ficheiro.CopyToAsync(fs);

                // salva imagem no banco de dados
                var ficheiroDados = new Entities.FicheiroUpload
                {
                    NomeFicheiroUpload = nomeFicheiroSeguro
                };
                await UploadRepository.UploadFicheiroDbAsync(ficheiroDados);
            }
            Ficheiro = new();
            Mensagem = "Arquivo(s) enviado(s) !!!!";
        }
        catch (Exception e)
        {
            Mensagem = "Error: " + e.Message;
        }
    }

    private class FicheiroUpload
    {
        [Required(ErrorMessage ="O título é obrigatório")]
        public string Titulo { get; set; } = String.Empty;

        [Required(ErrorMessage = "A descrição é obrigatória")]
        public string Descricao { get; set; } = String.Empty;

        public IFormFileCollection? Anexos { get; set; }
    }
}