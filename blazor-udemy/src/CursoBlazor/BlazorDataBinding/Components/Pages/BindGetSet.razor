@page "/bind-get-set"
@rendermode InteractiveServer

<h3>Utilizando <code>@@bind:get</code> e <code>@@bind:set</code></h3>

<h5>Usa o evento onchange por padrão (ao perder o foco)</h5>

<input @bind:get="texto"
       @bind:set="AtualizarTexto"/>

@code 
{
    private string texto = "inicial";
    private void AtualizarTexto(string? valor)
    {
        texto = string.IsNullOrWhiteSpace(valor) 
            ? "Valor Inválido" 
            : valor.Trim().ToUpper();
    }
}