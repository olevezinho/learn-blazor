@page "/oneway"
@rendermode InteractiveServer

<h3>Exemplo One-Way data binding</h3>

<p><b>Ao clicar no botão o nome será alterado para João.</b></p>

<p style="font-size: 40px;">Nome: @_nome</p>

<button @onclick="TrocarNome">Trocar Nome</button>

@code 
{
    private string _nome = "Maria";

    private void TrocarNome()
    {
        _nome = "João"; // Ao clicar o nome será alterado para João
    }
}