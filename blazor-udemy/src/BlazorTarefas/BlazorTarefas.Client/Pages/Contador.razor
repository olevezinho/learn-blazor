@page "/contador"
@rendermode InteractiveAuto

<PageTitle>Contador</PageTitle>

<h1>Demonstrando a Detecção de Pré-renderização</h1>

<div class="alert alert-warning mt-4">
    <h4><i class="bi bi-lightbulb"></i> Lógica de Dettcção</h4>
    <p>
        Usamos <code>RendererInfo.IsInteractive</code> para verificar o estado da pre-renderização.
        Quando o valor é <strong>false</strong>, o componente está a ser pré-renderizado.
        Quando é <strong>true</strong>, ele já está interativo.
    </p>
</div>

@*
    AQUI ESTÁ A LÓGICA DA SUA IMAGEM EM ACÇÃO!
*@

@if (!RendererInfo.IsInteractive)
{
    <div class="alert alert-info">
        <p class="mb-0">
            <i class="bi bi-server"></i>
            <strong>ESTADO ATUAL: PRÉ-RENDERIZAÇÃO.</strong>
            O componente está a ser renderizado no servidor. O botão abaixo está desabilitado.
        </p>
    </div>
}
else
{
    <div class="alert alert-success">
        <p class="mb-0">
            <i class="bi bi-mouse"></i>
            <strong>ESTADO ATUAL: INTERATIVO.</strong>
            O componente agora está vivo no <strong>@RendererInfo.Name</strong> e pode responder interativamente. O botão abaixo está habilitado.
        </p>
    </div>
}

<p role="status">Contagem atual: @currentCount</p>

<MudButton 
    Variant="Variant.Filled" 
    OnClick="IncrementCount"
    Disabled="@(!RendererInfo.IsInteractive)"
    StartIcon="@Icons.Material.Filled.Add" 
    Color="Color.Info" 
    Size="Size.Small">Clique aqui</MudButton>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
